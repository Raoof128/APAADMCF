# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/adm_compliance
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Security
SECRET_KEY=your-secret-key-here-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Azure Configuration (Australia East/Southeast)
AZURE_REGION=australiaeast
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_KEY_VAULT_URL=https://your-keyvault.vault.azure.net/

# Application Settings
APP_NAME=Australian Privacy Act ADM Compliance Framework
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# File Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=104857600  # 100MB

# Email/Alert Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.gov.au
SMTP_PASSWORD=your-smtp-password
ALERT_EMAIL_FROM=alerts@example.gov.au

# Monitoring
ENABLE_MONITORING=True
DRIFT_DETECTION_INTERVAL=86400  # 24 hours in seconds
ALERT_RETENTION_DAYS=90

# Individual Request SLA (in days)
REQUEST_SLA_DAYS=30

# Logging
LOG_LEVEL=INFO
