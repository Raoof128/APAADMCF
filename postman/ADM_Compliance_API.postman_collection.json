            "description": "Export all ADM systems to CSV format."
          },
          "response": []
        }
      ],
      "description": "Endpoints for managing ADM system registry including creation, retrieval, updates, and deletion."
    },
    {
      "name": "Privacy Impact Assessments",
      "item": [
        {
          "name": "Create PIA",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Has PIA ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set(\"pia_id\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adm_system_id\": \"{{adm_system_id}}\",\n  \"assessor_name\": \"Jane Smith\",\n  \"assessor_email\": \"jane.smith@example.gov.au\",\n  \"assessment_scope\": \"Full system assessment including data flows, security controls, and individual rights implementation\",\n  \"data_collected\": [\n    \"Full name\",\n    \"Date of birth\",\n    \"Tax File Number\",\n    \"Income records\",\n    \"Bank account details\",\n    \"Residential address\",\n    \"Family composition\"\n  ],\n  \"legal_basis\": \"Social Security Act 1991 - Section 192\",\n  \"data_retention_period_days\": 2555,\n  \"third_party_sharing\": true,\n  \"third_parties\": [\"Australian Taxation Office\", \"Department of Home Affairs\"],\n  \"international_transfers\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/pias",
              "host": ["{{base_url}}"],
              "path": ["pias"]
            },
            "description": "Create a new Privacy Impact Assessment for an ADM system."
          },
          "response": []
        },
        {
          "name": "List PIAs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pias?skip=0&limit=50",
              "host": ["{{base_url}}"],
              "path": ["pias"],
              "query": [
                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "status",
                  "value": "completed",
                  "disabled": true
                },
                {
                  "key": "adm_system_id",
                  "value": "{{adm_system_id}}",
                  "disabled": true
                }
              ]
            },
            "description": "List all PIAs with optional filters."
          },
          "response": []
        },
        {
          "name": "Get PIA",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pias/{{pia_id}}",
              "host": ["{{base_url}}"],
              "path": ["pias", "{{pia_id}}"]
            },
            "description": "Get detailed PIA information including risk assessments and mitigation actions."
          },
          "response": []
        },
        {
          "name": "Complete PIA",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"risk_assessments\": [\n    {\n      \"risk_category\": \"Unauthorized Access\",\n      \"severity\": \"high\",\n      \"likelihood\": 0.3,\n      \"impact_score\": 0.9,\n      \"description\": \"Potential for unauthorized access to sensitive welfare data\",\n      \"existing_controls\": \"Multi-factor authentication, role-based access control, audit logging\",\n      \"residual_risk\": \"medium\"\n    },\n    {\n      \"risk_category\": \"Algorithmic Bias\",\n      \"severity\": \"high\",\n      \"likelihood\": 0.4,\n      \"impact_score\": 0.8,\n      \"description\": \"Potential for discriminatory outcomes against protected groups\",\n      \"existing_controls\": \"Fairness testing, diverse training data, human oversight\",\n      \"residual_risk\": \"medium\"\n    }\n  ],\n  \"mitigation_actions\": [\n    {\n      \"action\": \"Implement quarterly fairness audits\",\n      \"priority\": \"high\",\n      \"responsible_party\": \"Data Science Team\",\n      \"due_date\": \"2024-03-31\",\n      \"status\": \"planned\"\n    }\n  ],\n  \"recommendations\": \"1. Conduct annual PIA reviews\\n2. Implement real-time bias monitoring\\n3. Provide transparency notices to all affected individuals\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pias/{{pia_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["pias", "{{pia_id}}", "complete"]
            },
            "description": "Complete a PIA with risk assessments and mitigation actions."
          },
          "response": []
        },
        {
          "name": "Download PIA Report (PDF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/pias/{{pia_id}}/report",
              "host": ["{{base_url}}"],
              "path": ["pias", "{{pia_id}}", "report"]
            },
            "description": "Download PIA report as PDF."
          },
          "response": []
        }
      ],
      "description": "Privacy Impact Assessment management endpoints."
    },
    {
      "name": "Fairness Assessments",
      "item": [
        {
          "name": "Create Fairness Assessment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Has assessment ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.collectionVariables.set(\"fairness_assessment_id\", jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adm_system_id\": \"{{adm_system_id}}\",\n  \"protected_attributes\": [\"gender\", \"age_group\", \"indigenous_status\"],\n  \"outcome_column\": \"approved\",\n  \"dataset\": {\n    \"records\": [\n      {\"gender\": \"male\", \"age_group\": \"25-34\", \"indigenous_status\": \"no\", \"approved\": 1, \"score\": 0.87},\n      {\"gender\": \"female\", \"age_group\": \"35-44\", \"indigenous_status\": \"no\", \"approved\": 1, \"score\": 0.92},\n      {\"gender\": \"male\", \"age_group\": \"45-54\", \"indigenous_status\": \"yes\", \"approved\": 0, \"score\": 0.42},\n      {\"gender\": \"female\", \"age_group\": \"25-34\", \"indigenous_status\": \"no\", \"approved\": 1, \"score\": 0.88}\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/fairness/assessments",
              "host": ["{{base_url}}"],
              "path": ["fairness", "assessments"]
            },
            "description": "Create a new fairness assessment. NOTE: This is a demo with minimal data. In production, upload a CSV file with thousands of records."
