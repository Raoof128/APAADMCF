        {
          "name": "List Requests (Privacy Officer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/requests?status=verified&limit=20",
              "host": ["{{base_url}}"],
              "path": ["requests"],
              "query": [
                {
                  "key": "status",
                  "value": "verified"
